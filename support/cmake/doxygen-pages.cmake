# Converts the MkDocs pages in doc/ into Markdown that Doxygen understands.
#
# Usage:
#   cmake -DSOURCE_DIR=<doc dir> -DOUTPUT_DIR=<out dir> -DPAGES="a.md,b.md"
#         -P doxygen-pages.cmake
#
# The following MkDocs-specific constructs are rewritten:
#   - YAML front matter (--- ... ---) at the top of a page is removed.
#   - Each page gets an explicit label so it is generated as <name>.html.
#   - mkdocstrings directives such as `::: print(format_string<T...>, T&&...)`
#     become links to the corresponding Doxygen entity.
#   - HTML anchors (<a id="x"></a>) become Doxygen anchors.
#   - Links to anchors (`#format-spec`, `syntax.md#format-spec`) become Doxygen
#     references; links to mkdocstrings entities (`#format_string`) become
#     references to the corresponding `fmt::` symbol.
#
# It also writes namespaces.dox which documents namespace fmt; without it
# Doxygen hides the namespace together with all of its functions.

foreach (var SOURCE_DIR OUTPUT_DIR PAGES)
  if (NOT DEFINED ${var})
    message(FATAL_ERROR "${var} is not set")
  endif ()
endforeach ()

# PAGES may be comma-separated to simplify passing it on the command line.
string(REPLACE "," ";" PAGES "${PAGES}")

file(MAKE_DIRECTORY "${OUTPUT_DIR}")

# Pass 1: collect HTML anchors and heading IDs from all pages since anchors
# are global and pages link to each other's anchors.
set(anchors)
foreach (page ${PAGES})
  file(STRINGS "${SOURCE_DIR}/${page}" ids REGEX "<a id=\"[^\"]+\"></a>")
  foreach (id ${ids})
    string(REGEX REPLACE ".*<a id=\"([^\"]+)\"></a>.*" "\\1" id "${id}")
    list(APPEND anchors "${id}")
  endforeach ()
  # Heading IDs, generated by Doxygen in GitHub style (MARKDOWN_ID_STYLE).
  file(STRINGS "${SOURCE_DIR}/${page}" headings REGEX "^#+ ")
  foreach (heading ${headings})
    string(REGEX REPLACE "^#+ +" "" id "${heading}")
    string(TOLOWER "${id}" id)
    string(REGEX REPLACE "[^a-z0-9 _-]" "" id "${id}")
    string(REPLACE " " "-" id "${id}")
    list(APPEND anchors "${id}")
  endforeach ()
endforeach ()

# Pass 2: convert the pages.
foreach (page ${PAGES})
  file(READ "${SOURCE_DIR}/${page}" content)

  # Strip YAML front matter.
  string(REGEX REPLACE "^---\n[^\n]*\n(([^-][^\n]*)?\n)*---\n" "" content
                       "${content}")
  # Join link targets that are split across lines, e.g. "(syntax.md#\nfoo)".
  string(REGEX REPLACE "(\\.md#)\n *" "\\1" content "${content}")

  # Doxygen page label (and output file name), e.g. get-started -> get_started.
  string(REGEX REPLACE "\\.md$" "" label "${page}")
  string(REPLACE "-" "_" label "${label}")

  # Process line by line. Escape semicolons and square brackets first since
  # they have special meaning in CMake lists.
  string(REPLACE ";" "@SEMICOLON@" content "${content}")
  string(REPLACE "[" "@LBRACKET@" content "${content}")
  string(REPLACE "]" "@RBRACKET@" content "${content}")
  string(REPLACE "\n" ";" lines "${content}")
  set(result "")
  set(labeled FALSE)
  foreach (line IN LISTS lines)
    if (NOT labeled AND line MATCHES "^# ")
      # Give the page a stable label so that it is generated as <label>.html.
      if (NOT page STREQUAL "index.md")
        set(line "${line} {#${label}}")
      endif ()
      set(labeled TRUE)
    elseif (line MATCHES "^::: (.*)$")
      set(signature "${CMAKE_MATCH_1}")
      # Drop the parameter list to get the entity name.
      string(REGEX REPLACE "\\(.*$" "" name "${signature}")
      if (name MATCHES "\"")
        # Doxygen can't reference literal operators like operator""_a.
        set(line "- `${signature}`")
      else ()
        if (NOT name MATCHES "^FMT_")
          set(name "fmt::${name}")
        endif ()
        set(line "- @ref ${name} \"${signature}\"")
      endif ()
    elseif (line MATCHES "^<a id=\"([^\"]+)\"></a>$")
      set(line "@anchor ${CMAKE_MATCH_1}")
    endif ()

    # Rewrite Markdown links to anchors and entities, possibly on other pages:
    #   [text](#format-spec), [text](syntax.md#format-spec) -> @ref format-spec
    #   [text](#format_string), [text](api.md#print)        -> @ref fmt::print
    while (line MATCHES "@RBRACKET@\\(([a-z-]+\\.md)?#([A-Za-z0-9_:-]+)\\)")
      set(link "${CMAKE_MATCH_0}")
      set(target "${CMAKE_MATCH_2}")
      if (target IN_LIST anchors OR target MATCHES "-")
        set(ref "${target}")
      else ()
        set(ref "fmt::${target}")
      endif ()
      string(REPLACE "${link}" "@RBRACKET@(@ref ${ref})" line "${line}")
    endwhile ()

    string(APPEND result "${line}\n")
  endforeach ()
  string(REPLACE "@SEMICOLON@" ";" result "${result}")
  string(REPLACE "@LBRACKET@" "[" result "${result}")
  string(REPLACE "@RBRACKET@" "]" result "${result}")

  # Links to whole pages: [text](syntax.md) -> syntax.html.
  string(REGEX REPLACE "\\]\\((api|syntax)\\.md\\)" "](\\1.html)" result
                       "${result}")
  string(REPLACE "](get-started.md)" "](get_started.html)" result "${result}")
  # MkDocs uses directory URLs like "api/#format" and "api#format" in HTML.
  string(REGEX REPLACE "href=\"(api|syntax)/?(#[^\"]*)?\""
                       "href=\"\\1.html\\2\"" result "${result}")
  string(REGEX REPLACE "href=\"get-started/?(#[^\"]*)?\""
                       "href=\"get_started.html\\1\"" result "${result}")

  file(WRITE "${OUTPUT_DIR}/${page}" "${result}")
endforeach ()

file(
  WRITE "${OUTPUT_DIR}/namespaces.dox"
  "/// @namespace fmt\n/// The {fmt} library API.\n\n/// @namespace fmt::literals\n/// User-defined literals.\n"
)
